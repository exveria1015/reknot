use reknot::typed::{BridgeOptions, RemoteCall};
use tokio::io::{AsyncBufReadExt, BufReader};

use {{crate}}_protocol::{module, Message, REPLY};

#[cfg(not(any(feature = "reload", feature = "static-logic")))]
compile_error!("enable reload or static-logic");

// Keep the DLL on this thread. The client below is Send + Sync and can also be
// cloned into a framework's multithreaded event handlers.
#[tokio::main(flavor = "current_thread")]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    #[cfg(feature = "reload")]
    let mut development = {
        use reknot::typed::{DevModule, DevOptions};
        let manifest = std::path::Path::new(env!("CARGO_MANIFEST_DIR")).join("../logic/Cargo.toml");
        eprintln!("Building {{package}}-logic for the first time...");
        // SAFETY: this local project, its dependencies and future edits are
        // trusted SDK-native code. External work must follow the SDK contracts.
        unsafe {
            DevModule::start(
                module().builder(),
                DevOptions::new(manifest, "{{package}}-logic"),
            )
        }?
    };
    #[cfg(feature = "reload")]
    let host = development.host().clone();
    #[cfg(all(feature = "static-logic", not(feature = "reload")))]
    // SAFETY: these generated callbacks are statically linked and resident.
    let host = unsafe { module().builder().from_api({{crate}}_logic::handler_api()) }?;
    // Requests use the executor's Waker, independently of source maintenance.
    let (client, mut driver) = host.bridge(BridgeOptions::default())?;
    let maintenance = async {
        #[cfg(feature = "reload")]
        {
            let mut tick = tokio::time::interval(std::time::Duration::from_millis(25));
            loop {
                tick.tick().await;
                if let Some(event) = development.update() { eprintln!("{event}"); }
            }
        }
        #[cfg(not(feature = "reload"))]
        std::future::pending::<()>().await;
    };
    tokio::pin!(maintenance);
    let reply = client.handler(REPLY)?;
    let mut received = 0;
    let mut lines = BufReader::new(tokio::io::stdin()).lines();
    let mut pending: Option<RemoteCall<Result<String, String>>> = None;
    println!("Ready. Enter text, /count or /quit. Edit logic/src/lib.rs and save.");
    let input_result = loop {
        tokio::select! {
            _ = &mut maintenance => unreachable!("maintenance loop ended"),
            _ = &mut driver => break Ok(()),
            result = async { pending.as_mut().unwrap().await }, if pending.is_some() => {
                pending = None;
                match result {
                    Ok(Ok(text)) => println!("{text}"),
                    Ok(Err(message)) => eprintln!("{message}"),
                    Err(error) => eprintln!("{error}"),
                }
            }
            line = lines.next_line() => {
                let text = match line {
                    Ok(Some(text)) => text,
                    Ok(None) => break Ok(()),
                    Err(error) => break Err(error),
                };
                if text == "/quit" { break Ok(()); }
                if text == "/count" { println!("Host received {received} messages"); continue; }
                if pending.is_some() {
                    eprintln!("Request in progress; wait for its reply before sending more text.");
                    continue;
                }
                received += 1; // Host state survives DLL updates.
                pending = Some(reply.call(Message { text, received }));
            }
        }
    };
    drop(pending);
    let (_, result) = tokio::join!(driver, client.shutdown());
    result?;
    input_result?;
    Ok(())
}
