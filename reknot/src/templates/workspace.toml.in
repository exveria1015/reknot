[workspace]
members = ["host", "logic", "protocol"]
default-members = ["host"]
resolver = "2"

[workspace.package]
version = "0.1.0"
edition = "2021"
rust-version = "{{msrv}}"
publish = false

[workspace.dependencies]
reknot = {{sdk}}
serde = { version = "1", features = ["derive"] }
tokio = { version = "1", features = ["rt", "macros", "time", "io-std", "io-util"] }
